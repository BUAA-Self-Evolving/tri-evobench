{
  "adapter": {
    "command": [
      "docker",
      "run",
      "--rm",
      "-i",
      "--user",
      "{uid}:{gid}",
      "-v",
      "{workspace_mount}:/workspace",
      "-v",
      "{state_mount}:/agent-state",
      "-e",
      "TRIEVO_REPO_ROOT=/opt/trievo",
      "-e",
      "PYTHONPATH=/opt/trievo/baseline/SkillOpt:/opt/trievo",
      "-e",
      "OPENAI_API_KEY",
      "-e",
      "OPENAI_COMPATIBLE_BASE_URL",
      "-e",
      "OPENAI_COMPATIBLE_API_KEY",
      "-e",
      "HTTP_PROXY",
      "-e",
      "HTTPS_PROXY",
      "-e",
      "NO_PROXY",
      "-e",
      "http_proxy",
      "-e",
      "https_proxy",
      "-e",
      "no_proxy",
      "{image}"
    ]
  },
  "workspace": {
    "adapter_path": "/workspace"
  },
  "state": {
    "adapter_path": "/agent-state"
  },
  "options": {
    "image": "trievo-skillopt:0.1"
  }
}
