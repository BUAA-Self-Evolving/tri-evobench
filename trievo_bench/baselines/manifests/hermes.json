{
  "schema_version": "1.0",
  "id": "hermes",
  "adapter": {
    "type": "process",
    "timeout_seconds": 1800,
    "cwd": "{repo_root}",
    "command": [
      "docker",
      "run",
      "--rm",
      "-i",
      "--name",
      "trievo-hermes-{instance_id}",
      "--user",
      "{uid}:{gid}",
      "--cap-drop",
      "ALL",
      "--security-opt",
      "no-new-privileges",
      "--pids-limit",
      "512",
      "--memory",
      "8g",
      "--cpus",
      "4",
      "-v",
      "{workspace}:/workspace",
      "-v",
      "{state_dir}:/hermes-state",
      "-e",
      "HERMES_HOME=/hermes-state",
      "-e",
      "HOME=/hermes-state/home",
      "-e",
      "OPENAI_API_KEY",
      "-e",
      "OPENROUTER_API_KEY",
      "-e",
      "ANTHROPIC_API_KEY",
      "-e",
      "DEEPSEEK_API_KEY",
      "-e",
      "DEEPSEEK_BASE_URL",
      "-e",
      "HTTP_PROXY=http://host.docker.internal:7890",
      "-e",
      "HTTPS_PROXY=http://host.docker.internal:7890",
      "-e",
      "NO_PROXY=localhost,127.0.0.1",
      "-e",
      "GEMINI_API_KEY",
      "-e",
      "GOOGLE_API_KEY",
      "-e",
      "XAI_API_KEY",
      "-e",
      "NOUS_API_KEY",
      "-e",
      "GLM_API_KEY",
      "-e",
      "ZAI_API_KEY",
      "-e",
      "Z_AI_API_KEY",
      "-e",
      "GLM_BASE_URL",
      "{image}"
    ],
    "cleanup_command": [
      "docker",
      "rm",
      "-f",
      "trievo-hermes-{instance_id}"
    ]
  },
  "source": {
    "path": "baseline/hermes-agent",
    "revision": "2d69ea3fe82aa33245c11a20a590450ef8ca2fb0"
  },
  "environment": {
    "inherit": [
      "OPENAI_API_KEY",
      "OPENROUTER_API_KEY",
      "ANTHROPIC_API_KEY",
      "DEEPSEEK_API_KEY",
      "DEEPSEEK_BASE_URL",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "NO_PROXY",
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY",
      "XAI_API_KEY",
      "NOUS_API_KEY",
      "GLM_API_KEY",
      "ZAI_API_KEY",
      "Z_AI_API_KEY",
      "GLM_BASE_URL"
    ]
  },
  "workspace": {
    "mode": "shared_volume",
    "adapter_path": "/workspace"
  },
  "state": {
    "scope": "flow",
    "adapter_path": "/hermes-state",
    "paths": [
      "memories/MEMORY.md",
      "memories/USER.md",
      "skills/**/*"
    ],
    "ignore_paths": [
      "skills/.usage.json",
      "skills/.usage.json.lock"
    ],
    "guard_paths": ["config.yaml"],
    "seed_files": ["config.yaml"],
    "enforce_turn_freeze": true
  },
  "evolution": {
    "policy": "turn_boundary",
    "timeout_seconds": 900
  },
  "options": {
    "image": "trievo-hermes:0.1",
    "approval_policy": "session",
    "allow_revision_mismatch": false
  },
  "capabilities": [
    "direct_workspace",
    "terminal",
    "memory",
    "skills",
    "events",
    "usage",
    "evolution_barrier"
  ]
}
