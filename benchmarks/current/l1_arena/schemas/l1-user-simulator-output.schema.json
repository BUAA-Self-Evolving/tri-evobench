{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l1-user-simulator-output.schema.json",
  "title": "L1 User Simulator Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "next_user_message",
    "rationale_category"
  ],
  "properties": {
    "schema_version": {
      "const": "l1_user_simulator_output/1.0"
    },
    "next_user_message": {
      "type": "string",
      "minLength": 1
    },
    "rationale_category": {
      "enum": [
        "incomplete_task",
        "incorrect_result",
        "invalid_artifact",
        "missing_evidence",
        "execution_error",
        "unanswered_requirement",
        "stale_or_missing_context",
        "unintended_persistence"
      ]
    }
  }
}
