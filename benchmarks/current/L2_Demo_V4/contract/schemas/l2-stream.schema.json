{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-benchmark.local/schemas/l2-stream.schema.json",
  "title": "L2 TaskStream Stream V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stream_id", "directory", "profile", "theme",
    "turn_count", "task_layout", "agent_workspace", "turn_type_counts",
    "fact_thread_count", "capability", "ordering", "execution_requirements", "turns"
  ],
  "properties": {
    "schema_version": {"const": "l2_taskstream/1.0"},
    "stream_id": {"$ref": "#/$defs/id"},
    "directory": {"$ref": "#/$defs/id"},
    "profile": {"type": "string", "minLength": 1},
    "theme": {"type": "string", "minLength": 1},
    "turn_count": {"type": "integer", "minimum": 1},
    "task_layout": {"const": "turn_directories"},
    "agent_workspace": {"const": "agent_workspace"},
    "turn_type_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "fact_thread_count": {"const": 0},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "family", "relation_type", "description"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/id"},
        "family": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1, "not": {"enum": ["mixed", "random"]}},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "seed", "turn_order", "note"],
      "properties": {
        "method": {"enum": ["fixed", "fixed_seed_shuffle"]},
        "seed": {"type": ["integer", "null"]},
        "turn_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^turn[1-9][0-9]*$"}
        },
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "fixed_seed_shuffle"}}},
          "then": {"properties": {"seed": {"type": "integer"}}}
        }
      ]
    },
    "execution_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "path_scope", "max_interactions", "max_tool_calls_per_interaction", "turn_timeout_seconds", "max_output_tokens"],
      "properties": {
        "network": {"const": "disabled"},
        "path_scope": {"const": "agent_workspace"},
        "max_interactions": {"const": 3},
        "max_tool_calls_per_interaction": {"type": "integer", "minimum": 1},
        "turn_timeout_seconds": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_id", "turn_index", "turn_type", "turn_origin", "sequence_role", "source_task_id"],
        "properties": {
          "turn_id": {"type": "string", "pattern": "^turn[1-9][0-9]*$"},
          "turn_index": {"type": "integer", "minimum": 1},
          "turn_type": {"type": "string", "minLength": 1},
          "turn_origin": {"enum": ["source_task", "derived_evolution_turn"]},
          "sequence_role": {"$ref": "#/$defs/sequenceRole"},
          "source_task_id": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sequenceRole": {
      "enum": ["learning", "application", "probe", "replay", "noise"],
      "description": "Role used for Stream-level learning-curve/evolution-gain aggregation. Current L2 Demo V3 uses learning/application/probe; replay/noise are reserved for future explicitly designed measurements."
    }
  }
}
