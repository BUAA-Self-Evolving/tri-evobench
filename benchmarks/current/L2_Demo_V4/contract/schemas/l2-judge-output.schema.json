{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-benchmark.local/schemas/l2-judge-output.schema.json",
  "title": "L2 Judge Output V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["stream_id", "turn_id", "interaction_index", "check_scores", "source_rubric_scores", "rationale"],
  "properties": {
    "stream_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "turn_id": {"type": "string", "pattern": "^turn[1-9][0-9]*$"},
    "interaction_index": {"type": "integer", "minimum": 1, "maximum": 3},
    "check_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "score", "reason", "evidence_refs"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "score": {"type": ["number", "null"], "enum": [0, 0.5, 1, null]},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "source_rubric_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubric_index", "score", "reason", "evidence_refs"],
        "properties": {
          "rubric_index": {"type": "integer", "minimum": 1},
          "score": {"type": ["number", "null"], "enum": [0, 0.5, 1, null]},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1}
  }
}
