{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-benchmark.local/schemas/l2-native-verifier-request.schema.json",
  "title": "L2 Native Verifier Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "l2_native_verifier_request/1.0"},
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": {"$ref": "#/$defs/bindingValue"}
    }
  },
  "$defs": {
    "bindingValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "inline"},
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"const": "path"},
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"}
          }
        }
      ]
    }
  }
}
