{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-benchmark.local/schemas/l2-bounded-feedback.schema.json",
  "title": "L2 Bounded Feedback V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "failed_dimensions", "observable_deficiency", "public_result_category"],
  "properties": {
    "schema_version": {"const": "l2_bounded_feedback/1.0"},
    "failed_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "observable_deficiency": {"type": "string", "minLength": 1},
    "public_result_category": {"enum": ["fail", "partial", "error"]}
  }
}
