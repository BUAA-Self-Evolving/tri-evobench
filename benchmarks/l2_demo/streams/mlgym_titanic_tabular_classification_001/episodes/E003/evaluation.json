{
  "schema_version": "demo-0.1",
  "episode_id": "E003",
  "visibility": "benchmark_private",
  "native_source": {
    "task_config": "evaluation_assets/source_task.yaml",
    "evaluator": "evaluation_assets/native_evaluate.py",
    "ground_truth": "evaluation_assets/ground_truth.csv"
  },
  "verifier": {
    "type": "mlgym_csv_submission_accuracy",
    "implementation": "package_local_python",
    "entrypoint": "l2_runtime.mlgym_titanic:MLGymTitanicVerifier",
    "interface": "verify(raw_model_output, episode_dir) -> VerifyResult",
    "inputs": [
      "raw_model_output",
      "workspace/episodes/E003/data/train.csv",
      "workspace/episodes/E003/data/test.csv"
    ],
    "assets": [
      "evaluation_assets/ground_truth.csv",
      "evaluation_assets/native_evaluate.py",
      "evaluation_assets/source_task.yaml"
    ]
  },
  "scoring": {
    "method": "native_accuracy",
    "range": [
      0,
      1
    ],
    "success_threshold": 0.76555,
    "success_threshold_source": "native task baseline_scores.Accuracy",
    "episode_score_policy": "latest_interaction",
    "criteria": [
      {
        "id": "native_titanic_accuracy",
        "description": "submission.csv is valid for derived fixed second-half PassengerId slice and its native accuracy meets or exceeds the task baseline 0.76555.",
        "measurement": "accuracy",
        "weight": 1.0,
        "partial_credit": true
      }
    ]
  },
  "gold": {
    "mode": "materialized_files",
    "ground_truth": "evaluation_assets/ground_truth.csv",
    "known_correct": "evaluation_assets/known_correct.py",
    "known_broken": "evaluation_assets/known_broken.py"
  },
  "feedback": {
    "visible_to_agent": "pass_fail_timeout_only",
    "allowed_categories": [
      "pass",
      "fail",
      "timeout"
    ],
    "hide": [
      "ground_truth",
      "per_row_correctness",
      "reference_script"
    ]
  }
}
