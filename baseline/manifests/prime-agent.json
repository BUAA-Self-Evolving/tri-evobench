{
  "schema_version": "1.0",
  "id": "prime-agent",
  "adapter": {
    "type": "process",
    "timeout_seconds": 1800,
    "cwd": "{repo_root}",
    "command": [
      "docker",
      "run",
      "--rm",
      "-i",
      "--name",
      "trievo-prime-agent-{instance_id}",
      "--user",
      "{uid}:{gid}",
      "--cap-drop",
      "ALL",
      "--security-opt",
      "no-new-privileges",
      "--pids-limit",
      "512",
      "--memory",
      "8g",
      "--cpus",
      "4",
      "-v",
      "{workspace_mount}:/workspace",
      "-v",
      "{state_mount}:/agent-state",
      "-e",
      "HOME=/agent-state/home",
      "-e",
      "OPENAI_API_KEY",
      "-e",
      "ANTHROPIC_API_KEY",
      "-e",
      "OPENROUTER_API_KEY",
      "-e",
      "GEMINI_API_KEY",
      "-e",
      "GOOGLE_API_KEY",
      "-e",
      "XAI_API_KEY",
      "-e",
      "TRIEVO_API_KEY",
      "-e",
      "TRIEVO_BASE_URL",
      "-e",
      "TRIEVO_MODEL",
      "-e",
      "HTTP_PROXY",
      "-e",
      "HTTPS_PROXY",
      "-e",
      "NO_PROXY",
      "-e",
      "http_proxy",
      "-e",
      "https_proxy",
      "-e",
      "no_proxy",
      "{image}"
    ],
    "cleanup_command": [
      "docker",
      "rm",
      "-f",
      "trievo-prime-agent-{instance_id}"
    ]
  },
  "source": {
    "path": "baseline/prime-agent",
    "revision": "163dd5798cd40e86b540aa9ecb68201920a83a1b"
  },
  "environment": {
    "inherit": [
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "OPENROUTER_API_KEY",
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY",
      "XAI_API_KEY",
      "TRIEVO_API_KEY",
      "TRIEVO_BASE_URL",
      "TRIEVO_MODEL",
      "TRIEVO_API_TIMEOUT_SECONDS",
      "TRIEVO_API_MAX_RETRIES",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "NO_PROXY",
      "http_proxy",
      "https_proxy",
      "no_proxy"
    ]
  },
  "workspace": {
    "mode": "shared_volume",
    "adapter_path": "/workspace"
  },
  "state": {
    "scope": "flow",
    "adapter_path": "/agent-state",
    "paths": [
      "prime-home/harness/**/*"
    ],
    "guard_paths": [
      "prime-home/models.json"
    ],
    "enforce_turn_freeze": true
  },
  "evolution": {
    "policy": "turn_boundary",
    "timeout_seconds": 900
  },
  "options": {
    "image": "trievo-prime-agent:0.1",
    "executable": "/opt/trievo/baseline/prime-agent/prime-agent.sh",
    "use_dist": true,
    "provider": "openai",
    "model": "gpt-5.5",
    "thinking": "medium",
    "base_url": "",
    "api": "openai-completions",
    "api_key_env": "TRIEVO_API_KEY",
    "context_window": 128000,
    "max_output_tokens": 16384,
    "reasoning": true,
    "allow_revision_mismatch": false
  },
  "capabilities": [
    "direct_workspace",
    "terminal",
    "python_repl",
    "continual_harness",
    "tool_calls",
    "usage",
    "evolution_barrier"
  ]
}
