{
  "schema_version": "1.0",
  "id": "deepseek-harness",
  "adapter": {
    "type": "process",
    "timeout_seconds": 1800,
    "cwd": "{repo_root}",
    "command": [
      "docker", "run", "--rm", "-i", "--init",
      "--name", "trievo-deepseek-harness-{instance_id}",
      "--user", "{uid}:{gid}", "--cap-drop", "ALL",
      "--security-opt", "no-new-privileges", "--pids-limit", "512",
      "--memory", "8g", "--cpus", "4",
      "-v", "{workspace_mount}:/workspace", "-v", "{state_mount}:/agent-state",
      "-e", "TRIEVO_API_KEY", "-e", "TRIEVO_BASE_URL", "-e", "TRIEVO_MODEL",
      "-e", "DEEPSEEK_API_KEY", "-e", "DEEPSEEK_BASE_URL",
      "-e", "HTTP_PROXY", "-e", "HTTPS_PROXY", "-e", "NO_PROXY",
      "-e", "http_proxy", "-e", "https_proxy", "-e", "no_proxy", "{image}"
    ],
    "cleanup_command": ["docker", "rm", "-f", "trievo-deepseek-harness-{instance_id}"]
  },
  "source": {
    "path": "baseline/deepseek-harness",
    "revision": "d743267388641bc76f17c45ce8b4c231aed1d32c"
  },
  "environment": {
    "inherit": [
      "TRIEVO_API_KEY", "TRIEVO_BASE_URL", "TRIEVO_MODEL", "DEEPSEEK_API_KEY", "DEEPSEEK_BASE_URL",
      "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "no_proxy"
    ]
  },
  "workspace": {"mode": "shared_volume", "adapter_path": "/workspace"},
  "state": {
    "scope": "flow", "adapter_path": "/agent-state",
    "paths": ["learning/**/*"], "enforce_turn_freeze": true
  },
  "evolution": {"policy": "disabled", "timeout_seconds": 900},
  "options": {
    "image": "trievo-deepseek-harness:0.1",
    "executable": "/opt/deepseek-harness/apps/cli/lib/bin.js",
    "model": "deepseek-v4-flash", "base_url": "", "api_key_env": "TRIEVO_API_KEY",
    "reasoning_effort": "high", "max_output_tokens": 16384,
    "request_timeout_seconds": 1700, "allow_revision_mismatch": false
  },
  "capabilities": ["direct_workspace", "terminal", "tool_calls", "usage", "evolution_barrier"]
}
