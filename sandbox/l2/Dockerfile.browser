FROM trievo-l2:0.1

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PLAYWRIGHT_DOWNLOAD_HOST

ENV PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=120000

# Optional image for the two L2 native browser-smoke streams. Kept separate from
# the API/runtime image because Chromium materially increases image size.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir 'playwright>=1.50,<2' 'pytest>=8,<10'
RUN playwright install-deps chromium
RUN playwright install --only-shell chromium
