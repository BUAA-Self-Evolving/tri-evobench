FROM trievo-l2-v5:0.4

# Source-native superset for the rebuilt L2 V5 pool. Upstream SkillLearnBench
# and SkillsBench tasks each ship a task Dockerfile; this image unions the
# install steps that the admitted CPU tasks need so task and verifier
# containers stay network-disabled at run time. Tasks whose red/green
# qualification still fails in this image are not admitted.

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG APT_ORIGIN=http://deb.debian.org

RUN sed -i "s|http://deb.debian.org|${APT_ORIGIN}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        unzip zip jq git curl wget bc file \
        imagemagick ffmpeg tesseract-ocr ghostscript \
        libreoffice-writer libreoffice-calc libreoffice-impress \
        gnumeric default-jre-headless graphviz \
        libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" \
    'pytest-json-ctrf==0.3.5' 'pytest-asyncio>=0.23,<2' \
    'pdfplumber>=0.11,<1' 'PyPDF2>=3,<4' 'pdfrw>=0.4,<1' 'fillpdf>=0.7,<1' \
    'pdf2image>=1.17,<2' 'tabula-py>=2.9,<3' 'pytesseract>=0.3,<1' \
    'xlrd>=2,<3' 'defusedxml>=0.7,<1' 'bibtexparser>=1.4,<2' 'pyyaml>=6,<7' \
    'pillow>=10,<12' 'tqdm>=4,<5' 'joblib>=1.3,<2' 'httpx>=0.27,<1' \
    'shapely>=2,<3' 'pyproj>=3.6,<4' 'geopandas>=1,<2' 'netCDF4>=1.7,<2' \
    'opencv-python-headless>=4.9,<5' 'paretoset>=1.2,<2' \
    'pyperplan>=2.1,<3' 'unified-planning>=1.1,<2' 'up-pyperplan>=1.1,<2' \
    'pyscipopt>=5,<6' 'astropy>=6,<8' 'numba>=0.60,<1' 'bokeh>=3.4,<4' \
    'statsmodels>=0.14,<1' 'networkx>=3.2,<4' 'sympy>=1.12,<2' \
    'graphviz>=0.20,<1' 'scapy>=2.5,<3'

WORKDIR /workspace
CMD ["sleep", "infinity"]
