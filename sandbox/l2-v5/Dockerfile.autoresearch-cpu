# AutoResearch CPU task image for the rebuilt L2 V5 pool.
#
# Superset of the agent-side and verifier-side Python dependencies of the
# admitted AIRS-Bench (rad) and MLGym tasks, CPU-only. Every verifier,
# including the verifiers of GPU-flagged tasks, runs in this image with the
# network disabled. Upstream sources of the pins:
#   * AIRS metadata.yaml container/evaluate_container_python_requirements
#     (datasets==4.0.0, torchmetrics, sktime, rouge_score, evaluate, scipy)
#   * MLGym rl*/requirements.txt (gymnax, flax, optax, tensorflow_probability,
#     dotmap; jax[cuda12] replaced by jax CPU wheels). JAX is pinned to 0.5.3
#     because gymnax 0.0.8 calls jax.tree_map, removed in JAX 0.6 (the 0.6-native
#     base ships jax 0.10.2, which this layer downgrades).
#   * MLGym generic conda env (torch, transformers, scikit-learn, pandas)
# torch comes from the official CPU wheel index so no CUDA libraries are
# pulled in.
ARG BASE_IMAGE=trievo-l2-v5:0.6-native
FROM ${BASE_IMAGE}

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir --index-url "${TORCH_INDEX_URL}" \
        'torch==2.6.0+cpu' 'torchvision==0.21.0+cpu'

RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" \
        'datasets==4.0.0' 'torchmetrics>=1.4,<2' 'transformers>=4.44,<5' \
        'tokenizers>=0.19' 'safetensors>=0.4' 'accelerate>=0.33,<2' \
        'scikit-learn>=1.5' 'lightgbm>=4.3,<5' 'xgboost-cpu>=2.1,<4' \
        'sktime>=0.30,<1' 'statsforecast>=1.7,<3' 'rouge_score==0.1.2' 'evaluate>=0.4,<1' \
        'nltk>=3.8' 'sentencepiece>=0.2' 'torch_geometric>=2.5,<3' \
        'jax[cpu]==0.5.3' 'jaxlib==0.5.3' 'flax==0.10.4' 'optax>=0.2,<0.3' 'chex>=0.1.86' \
        'gymnax==0.0.8' 'tensorflow-probability>=0.24,<0.26' 'dotmap>=1.3' \
        'pyyaml>=6' 'tqdm>=4'

# Fail the build if a verifier dependency cannot be imported.
RUN python -c "import torch, datasets, torchmetrics, transformers, sklearn, lightgbm, xgboost, sktime, rouge_score, evaluate, scipy, jax, flax, optax, gymnax, tensorflow_probability.substrates.jax, dotmap, torch_geometric; print(torch.__version__, datasets.__version__, jax.__version__)"

ENV HF_DATASETS_OFFLINE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false JAX_PLATFORMS=cpu
WORKDIR /workspace
CMD ["sleep", "infinity"]
